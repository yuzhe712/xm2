APP_NAME=IntelliTicket Backend
APP_VERSION=0.1.0
APP_ENV=development
DATA_MODE=mock
MOCK_DATA_DIR=mock_data
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# 可选：指向部署环境自己的密钥文件；不使用时保持注释，只读取环境变量。
# INTELLITICKET_SECRET_FILE=C:/path/to/intelliticket-secrets.toml
TICKET_HISTORY_DB_PATH=data/intelliticket.sqlite3
# 生产环境必须使用 postgresql+psycopg://...；开发环境未配置时沿用上方 SQLite。
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/intelliticket
# Compose 使用下列密码初始化 PostgreSQL；如密码含 URL 保留字符，需要先进行 URL 编码。
# POSTGRES_PASSWORD=
# 生产环境必须设置至少 32 位的随机签名密钥，不能使用项目内开发默认值。
# JWT_SECRET_KEY=
# 首次部署可临时设置；账号创建后应从运行环境移除密码变量。
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
# HTTP_PORT=8080

# P2 asynchronous AI tasks
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# CELERY_QUEUE_NAME=celery
# READINESS_TIMEOUT_SECONDS=1
# AI_TASK_MAX_RETRIES=3
# AI_TASK_STALE_SECONDS=900
# BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
# 附件仅保存到服务端生成的随机文件名；Nginx 上传限制应与此值保持一致。
# ATTACHMENT_STORAGE_DIR=data/attachments
# ATTACHMENT_MAX_BYTES=26214400
# DINGTALK_ENABLED=false
# DINGTALK_OPERATOR_WEBHOOK_URL=
# DINGTALK_EMPLOYEE_WEBHOOK_URL=
# NOTIFICATION_TASK_MAX_RETRIES=3
# NOTIFICATION_TASK_RETRY_BACKOFF_SECONDS=10
# 单公司单实例部署时，如桌面端不在默认本机地址访问后端，请同步配置允许的前端来源。
FRONTEND_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# 可选：飞书 Drive 文件夹知识接入。真实密钥只写入 .env，不要提交到仓库。
# KNOWLEDGE_PROVIDER=feishu
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_DRIVE_FOLDER_URL=https://my.feishu.cn/drive/folder/xxx
# FEISHU_DRIVE_FOLDER_TOKEN=xxx
# FEISHU_BASE_URL=https://open.feishu.cn
# FEISHU_TIMEOUT_SECONDS=5
# FEISHU_MAX_RESULTS=5
# 旧 Wiki Space 配置；当前 Drive 文件夹模式不需要。
# FEISHU_WIKI_SPACE_ID=spc_xxx
